{
  "name": "@treegress.com/treegress-browser-mcp",
  "version": "0.0.56-treegress.17",
  "description": "Treegress browser tools for MCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MobiDev-Org/treegress-browser-mcp.git"
  },
  "homepage": "https://treegress.com",
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "mobidev.biz"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "npm run update-readme",
    "update-readme": "node update-readme.js",
    "test": "playwright test",
    "ctest": "playwright test --project=chrome",
    "ftest": "playwright test --project=firefox",
    "wtest": "playwright test --project=webkit",
    "dtest": "MCP_IN_DOCKER=1 playwright test --project=chromium-docker",
    "npm-publish": "npm run lint && npm run test && npm publish",
    "copy-config": "cp ../../../../MONO/playwright/packages/playwright/src/mcp/config.d.ts . && perl -pi -e \"s|import type \\* as playwright from 'playwright-core';|import type * as playwright from 'playwright';|\" ./config.d.ts",
    "roll": "npm run copy-config && npm run lint"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "dependencies": {
    "playwright": "1.58.0-alpha-2026-01-16",
    "playwright-core": "npm:@treegress.com/treegress-browser-core@1.59.0-treegress.12"
  },
  "bin": {
    "treegress-browser-mcp": "cli.js"
  }
}
